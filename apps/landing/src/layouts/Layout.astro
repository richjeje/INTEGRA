---
import '../styles/global.css';
import '../styles/hero.css';
import '../styles/companies.css';
import '../styles/expansion.css';
import Header from '../components/Header.astro';
interface Props { title?: string; description?: string; brand?: 'home' | 'integra' | 'met' | 'rent'; }
const { title = 'Integra | Ingeniería, manufactura y renta de equipo', description = 'Ingeniería e integración industrial, manufactura en metal y renta de equipo en Aguascalientes.', brand = 'home' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content={brand === 'integra' || brand === 'home' ? '#CF202E' : '#10243A'} /><meta name="robots" content="noindex, nofollow" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><title>{title}</title></head>
  <body data-brand={brand}><Header brand={brand} /><main id="contenido"><slot /></main><script src="../scripts/site.ts"></script></body>
</html>

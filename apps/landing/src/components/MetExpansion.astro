---
interface Props { stage?: 'after'; }
const { stage = 'after' } = Astro.props;
const whatsappMessage = encodeURIComponent('Hola, me interesa cotizar una pieza o proyecto de manufactura con Integra Steel.');
---
{stage === 'after' && <>
<section id="flujo-met" class="section fabrication-flow"><div class="shell"><div><p class="eyebrow">Del proceso al conjunto</p><h2>Una pieza bien definida avanza mejor.</h2></div><ol><li><span>01</span><strong>Corte</strong><small>Geometría inicial</small></li><li><span>02</span><strong>Conformado</strong><small>Dobleces o curvatura</small></li><li><span>03</span><strong>Ensamble</strong><small>Unión del conjunto</small></li><li><span>04</span><strong>Revisión</strong><small>Condiciones acordadas</small></li></ol></div></section>

<section id="brief-met" class="section project-brief project-brief--met"><div class="shell project-cta"><div><p class="eyebrow">¿Tienes una pieza o proyecto en mente?</p><h2>Fabricamos a la medida de tu necesidad.</h2><p>Comparte tu plano, material o idea inicial. Revisaremos contigo el proceso adecuado para llevarla a fabricación.</p></div><a class="whatsapp-cta" href={`https://wa.me/524495411077?text=${whatsappMessage}`} target="_blank" rel="noopener noreferrer" aria-label="Cotizar con Integra Steel por WhatsApp"><svg class="whatsapp-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.1 3.9A11.3 11.3 0 0 0 2.3 17.5L1 22.8l5.4-1.4a11.3 11.3 0 0 0 5.4 1.4h.1A11.3 11.3 0 0 0 20.1 3.9Z"/><path d="M8.6 7.4c.3-.4.7-.4 1-.1l1.2 1.6c.2.3.2.6 0 .9l-.7.8c.7 1.5 1.8 2.5 3.3 3.1l.8-.8c.2-.2.6-.3.9-.1l1.6.9c.4.2.5.7.2 1.1-.5.8-1.5 1.2-2.5 1-3.6-.8-6.7-3.9-7.2-7.5-.1-.8.4-1.5 1.4-.9Z"/></svg><span>Cotizar por WhatsApp</span></a></div></section>
</>}

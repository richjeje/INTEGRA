---
const reasons = [
  ['01', 'Una sola conversación', 'Coordinamos ingeniería, manufactura y equipo alrededor de la misma necesidad.'],
  ['02', 'Capacidad conectada', 'Cada división entra cuando aporta valor al alcance, sin fragmentar el proyecto.'],
  ['03', 'Decisiones verificables', 'Revisamos capacidades, condiciones y entregables antes de avanzar.'],
];
const roles = [
  ['IN', 'Ingeniería', 'Concepto, dimensionamiento e integración.'],
  ['MF', 'Manufactura', 'Corte, conformado, soldadura y ensamble.'],
  ['AU', 'Automatización', 'Lógica, control, seguridad y pruebas.'],
  ['CM', 'Campo', 'Equipo, instalación y puesta en marcha.'],
];
---
<section id="por-que" class="section home-why" aria-labelledby="home-why-title"><div class="shell">
  <div class="section-heading"><div><p class="eyebrow red">¿Por qué Integra?</p><h2 id="home-why-title">Capacidades que trabajan juntas.</h2></div><p class="section-copy">La necesidad guía el proyecto. Después conectamos las especialidades necesarias para resolverla con claridad.</p></div>
  <div class="home-reason-grid">{reasons.map(([number,title,copy]) => <article><span>{number}</span><h3>{title}</h3><p>{copy}</p></article>)}</div>
</div></section>

<section id="equipo" class="section home-team" aria-labelledby="home-team-title"><div class="shell">
  <div class="section-heading"><div><p class="eyebrow">Equipo multidisciplinario</p><h2 id="home-team-title">Las especialidades que acompañan el proyecto.</h2></div><p class="section-copy">Cada frente participa con información concreta para que la solución pueda diseñarse, fabricarse e implementarse.</p></div>
  <div class="home-role-grid">{roles.map(([initials,title,copy]) => <article><span>{initials}</span><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div>
</div></section>

---
interface Props { brand?: 'home' | 'integra' | 'met' | 'rent'; }
const { brand = 'home' } = Astro.props;
const content = {
  home: {
    eyebrow: 'Capacidad conectada',
    title: 'Un mismo grupo para avanzar de la idea al trabajo en campo.',
    stats: [['3', 'divisiones especializadas'], ['11', 'equipos documentados'], ['5', 'materiales con capacidad registrada']],
    href: '/integra/',
    action: 'Conocer nuestras capacidades',
  },
  integra: {
    eyebrow: 'Ingeniería coordinada',
    title: 'Diseño, fabricación, programación e instalación en una sola ruta.',
    stats: [],
    href: '#brief-integra',
    action: 'Platicar sobre mi proyecto',
  },
  met: {
    eyebrow: 'Capacidad documentada',
    title: 'Procesos y materiales revisados antes de fabricar.',
    stats: [['4', 'procesos de manufactura'], ['5', 'materiales documentados'], ['5', 'familias de perfiles']],
    href: '#brief-met',
    action: 'Revisar mi pieza',
  },
  rent: {
    eyebrow: 'Selección con contexto',
    title: 'El equipo se confirma según el trabajo y las condiciones del sitio.',
    stats: [['11', 'equipos con ficha']],
    href: '#brief-rent',
    action: 'Consultar disponibilidad',
  },
};
const current = content[brand];
---
<section class:list={['trust-band', `trust-band--${brand}`]} aria-label="Datos de confianza">
  <div class="shell trust-band-layout">
    <div class="trust-band-copy"><p>{current.eyebrow}</p><h2>{current.title}</h2></div>
    {current.stats.length > 0 && <dl>{current.stats.map(([value,label]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}
    <a href={current.href}>{current.action}<span aria-hidden="true">→</span></a>
  </div>
</section>

---
import Brand from './Brand.astro';
import Photo from './Photo.astro';
const units = [
  { id: 'integra', unit: '', number: '01', text: 'Ingeniería e integración', detail: 'Soluciones para tu operación.' },
  { id: 'met', unit: 'met', number: '02', text: 'Manufactura en metal', detail: 'De tus planos a la pieza.' },
  { id: 'rent', unit: 'rent', number: '03', text: 'Renta de equipo', detail: 'Capacidad para tu instalación.' },
];
---
<section class="introduction hero" id="inicio" aria-labelledby="intro-title">
  <Photo name="integra-dolly" alt="Dolly industrial amarillo en una instalación de manufactura" class="hero-background" eager />
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-main shell">
    <p class="hero-tagline">Control total en movimiento</p>
    <h1 id="intro-title">Ingeniería que integra.<br /><span>Industria en movimiento.</span></h1>
    <p class="hero-description">Integra, Met y Rent conectan ingeniería, manufactura y equipo para impulsar tu operación.</p>
    <div class="hero-actions"><a class="hero-primary" href="#empresas">Explorar soluciones</a><a class="hero-secondary" href="/integra/">Conocer Integra</a></div>
  </div>
  <nav class="unit-index shell" id="empresas" aria-label="Explorar nuestras empresas">
    {units.map(unit => <a href={`/${unit.id}/`} class={`unit-index-item ${unit.id}`}>
      <div class="unit-index-top"><Brand unit={unit.unit} /><span class="index-number">{unit.number}</span></div>
      <p>{unit.text}</p><span class="unit-description">{unit.detail}</span>
    </a>)}
  </nav>
</section>

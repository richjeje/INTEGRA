{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/met",
      "destination": "/integra-steel/",
      "permanent": true
    },
    {
      "source": "/rent",
      "destination": "/integra-rigging/",
      "permanent": true
    },
    {
      "source": "/met/",
      "destination": "/integra-steel/",
      "permanent": true
    },
    {
      "source": "/rent/",
      "destination": "/integra-rigging/",
      "permanent": true
    }
  ]
}
